# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ── Python (hooks) ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Machine-local environment state ──────────────────────────────────────────
# Records THIS machine's capabilities (OS, python command, git availability,
# schema_validation / version_control flags). Machine-specific, so it never
# travels with the repo — a clone on another machine re-runs the capability
# check and writes its own. See CLAUDE.md § Environment & Capabilities.
.pm-os-env.json

# ── brain/source/ ────────────────────────────────────────────────────────────
# Raw artifacts — immutable originals. Large files, sensitive transcripts.
# Directories are tracked via .gitkeep; contents are not.
# DEFAULT = "Synthesis only": raw transcripts stay local; ingestion/ (which the
# claim links depend on) is always tracked. /pm-brain removes this whole block if
# the PM chose "Full audit trail" at setup (Batch E Q4). See CLAUDE.md § Source Preservation.
brain/source/interviews/*
!brain/source/interviews/.gitkeep
brain/source/meetings/*
!brain/source/meetings/.gitkeep
brain/source/market/*
!brain/source/market/.gitkeep
brain/source/adhoc/*
!brain/source/adhoc/.gitkeep

# NOTE: brain/ingestion/ is intentionally NOT ignored. Durable knowledge claims
# link to it via `[ingestion/...]` (the highest-trust provenance tag); ignoring it
# would leave every claim's primary link dangling on clone. It always travels.

# ── outputs/ ─────────────────────────────────────────────────────────────────
# Generated deliverables — PRDs, plans, etc. Not source of truth.
outputs/*
!outputs/.gitkeep

# ── maintenance/log/ ─────────────────────────────────────────────────────────
maintenance/log/*
!maintenance/log/.gitkeep
