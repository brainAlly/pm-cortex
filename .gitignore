# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor
.vscode/
.idea/
*.swp
*.swo

# Python (validate_brain_file.py hook)
__pycache__/
*.pyc
*.pyo

# Runtime brain data — populated by each user, not part of the plugin
# Keep .gitkeep files so directory structure is preserved
plugins/pm-brain/scaffold/brain/source/meetings/*
plugins/pm-brain/scaffold/brain/source/interviews/*
plugins/pm-brain/scaffold/brain/source/market/*
plugins/pm-brain/scaffold/brain/source/adhoc/*
plugins/pm-brain/scaffold/brain/ingestion/meetings/*
plugins/pm-brain/scaffold/brain/ingestion/interviews/*
plugins/pm-brain/scaffold/brain/ingestion/market/*
plugins/pm-brain/scaffold/brain/ingestion/adhoc/*
!plugins/pm-brain/scaffold/brain/source/**/.gitkeep
!plugins/pm-brain/scaffold/brain/ingestion/**/.gitkeep

# Runtime outputs — generated by the PM at use time
plugins/pm-brain/scaffold/outputs/*
!plugins/pm-brain/scaffold/outputs/.gitkeep

# Maintenance logs — runtime, not plugin state
plugins/pm-brain/scaffold/maintenance/log/*
!plugins/pm-brain/scaffold/maintenance/log/.gitkeep

# Environment
.env
.env.local
